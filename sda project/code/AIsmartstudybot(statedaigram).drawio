<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="eZm5jUMH1E1DGRlZ4yRX">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="AdNmpqE42daUev6yq7hu-0" />
        <mxCell id="AdNmpqE42daUev6yq7hu-1" parent="AdNmpqE42daUev6yq7hu-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide empty description\nskinparam backgroundColor transparent\nskinparam DefaultFontColor white\nskinparam ArrowColor white\nskinparam ArrowFontColor white\nskinparam StateBackgroundColor transparent\nskinparam StateBorderColor white\nskinparam StateFontColor white\nskinparam StateAttributeFontColor white\n\n[*] --&gt; SystemSetup\n\nstate SystemSetup {\n    [*] --&gt; InstallingDependencies : Run SMART_SETUP\\n(Python libs, Playwright, Chromium)\n    InstallingDependencies --&gt; VerifyingInstallation : Run VERIFY_INSTALL\\n(APIs, Modules, Browser)\n    VerifyingInstallation --&gt; InstallError : [Verification Failed]\n    InstallError --&gt; InstallingDependencies : Retry Setup\n    VerifyingInstallation --&gt; GoogleAuthentication : [All Checks Passed]\n    GoogleAuthentication --&gt; ScheduleConfiguration : User logs into Google\\n(Save session cookies + bot profile)\n    ScheduleConfiguration --&gt; [*] : schedule.json configured\\n(class, time, platform, link,\\ntelegram_id, gemini_key, credentials)\n}\n\nSystemSetup --&gt; IdleScheduler : Setup Complete\n\nstate IdleScheduler {\n    [*] --&gt; PollingTime\n    PollingTime --&gt; PollingTime : [current_time != class_time]\\nWait loop continues\n    PollingTime --&gt; HumanDelay : [current_time == class_time]\n    HumanDelay --&gt; HumanDelay : Simulate human behaviour\\nWait 2 minutes before joining\n    PollingTime --&gt; LateJoinCheck : [class_time already passed]\n    LateJoinCheck --&gt; HumanDelay : [Within 20-min late tolerance]\n    LateJoinCheck --&gt; ClassMissed : [Beyond 20-min late window]\n    ClassMissed --&gt; TelegramMissedClass : Log missed class + timestamp\n    TelegramMissedClass --&gt; PollingTime : Send Telegram [Class Missed]\\nContinue scheduling\n    PollingTime --&gt; ExceptionLogger : [Invalid Link / Network Error]\n    ExceptionLogger --&gt; PollingTime : Log saved for debugging\n}\n\nIdleScheduler --&gt; ClassJoining : [current_time == class_time + 2 min delay]\nIdleScheduler --&gt; ClassJoining : [Late join within 20-min tolerance]\n\nstate ClassJoining {\n    [*] --&gt; OpeningBrowser : Playwright + Chromium launched\\n(Using saved Google session cookies)\n    OpeningBrowser --&gt; LoadingMeetingURL : Browser ready\n    LoadingMeetingURL --&gt; JoinError : [Network failure / Invalid link]\n    JoinError --&gt; TelegramJoinFail : Log error details\n    TelegramJoinFail --&gt; [*] : Send Telegram [Class Join Failed]\\nAbort this session\n    LoadingMeetingURL --&gt; ConfiguringMeeting : [Page loaded successfully]\n    ConfiguringMeeting --&gt; MicOff : Start configuration sequence\n    MicOff --&gt; CamOff : Turn OFF Microphone\\n(Prevent audio broadcast)\n    CamOff --&gt; ChatOpen : Turn OFF Camera\\n(Prevent video broadcast)\n    ChatOpen --&gt; CaptionsOn : Open Chatbox\\n(Required for attendance + AI answers)\n    CaptionsOn --&gt; CaptionsUrdu : Enable Live Captions\\n(Required for Whisper processing)\n    CaptionsUrdu --&gt; [*] : Set Captions Language to Urdu\\n(Localization for student context)\n}\n\nClassJoining --&gt; ActiveClassMonitoring : Send Telegram [Class Joined]\\nLog join timestamp\n\nstate ActiveClassMonitoring {\n\n    state AttendanceManager {\n        [*] --&gt; ScanningForAttendance\n        ScanningForAttendance --&gt; AttendanceTriggerVoice : Voice [Whisper detects keywords:\\n\&quot;attendance\&quot; / \&quot;roll call\&quot; / \&quot;present\&quot;]\n        ScanningForAttendance --&gt; AttendanceTriggerName : Voice [Whisper detects student own name]\n        ScanningForAttendance --&gt; AttendanceTriggerChat : Chat [4-5 \&quot;Present\&quot; burst messages scraped]\n        AttendanceTriggerVoice --&gt; MarkingAttendance : Valid voice keyword trigger\n        AttendanceTriggerName --&gt; MarkingAttendance : Name-based trigger confirmed\n        AttendanceTriggerChat --&gt; MarkingAttendance : Chat burst pattern confirmed\n        MarkingAttendance --&gt; AttendanceMarked : Action [Type \&quot;Present\&quot; in chat]\n        MarkingAttendance --&gt; AttendanceFailed : [Chat send error]\n        AttendanceMarked --&gt; ResettingTrigger : Send Telegram [Attendance Marked]\n        AttendanceFailed --&gt; ResettingTrigger : Send Telegram [Attendance Missed]\n        ResettingTrigger --&gt; ScanningForAttendance : [Wait 5 minutes then re-check]\n    }\n\n    --\n\n    state AIQuestionResponder {\n        [*] --&gt; ListeningToTeacher\n        ListeningToTeacher --&gt; TranscribingSpeech : Voice [Audio chunk captured]\n        TranscribingSpeech --&gt; QuestionDetected : Whisper converts speech to text\n        QuestionDetected --&gt; CallingGemini : API Call [Send question to Gemini API]\n        CallingGemini --&gt; AnswerReady : [Gemini returns answer]\n        CallingGemini --&gt; GeminiFailed : [Gemini API error / rate limit]\n        GeminiFailed --&gt; CallingGroq : Fallback [Send to Groq API\\n(Higher rate limits / Faster LLM)]\n        CallingGroq --&gt; AnswerReady : [Groq returns answer]\n        CallingGroq --&gt; APITotalFail : [Groq also failed]\n        APITotalFail --&gt; ListeningToTeacher : Log error\\nSkip response this round\n        AnswerReady --&gt; ReplyingInChat : Action [Bot types AI answer automatically]\n        ReplyingInChat --&gt; ListeningToTeacher : Answer posted\\nResume listening\n    }\n\n    --\n\n    state ExitMonitor {\n        [*] --&gt; CheckingExitConditions\n        CheckingExitConditions --&gt; CheckingExitConditions : [Participants &gt;= 5]\\nAND [Time &lt; class_end + 5 min]\n        CheckingExitConditions --&gt; ExitTriggered : [Participants &lt; 5]\n        CheckingExitConditions --&gt; ExitTriggered : [class_time + 5 min buffer elapsed]\n        ExitTriggered --&gt; ExitTriggered : Exit condition confirmed\\nSignalling leave class\n    }\n\n}\n\nActiveClassMonitoring --&gt; ExceptionHandling : Exception [Network / API Failure / Login Timeout]\n\nstate ExceptionHandling {\n    [*] --&gt; LoggingError\n    LoggingError --&gt; IdentifyingError : Write to log file with timestamp\n    IdentifyingError --&gt; NetworkRecovery : [Network failure detected]\n    IdentifyingError --&gt; APIRecovery : [API failure — Gemini / Groq]\n    IdentifyingError --&gt; LoginRecovery : [Google login timeout / session expired]\n    IdentifyingError --&gt; LinkRecovery : [Invalid meeting link]\n    NetworkRecovery --&gt; [*] : Wait for reconnection\\nResume on network restored\n    APIRecovery --&gt; [*] : Activate fallback API\\nRetry with Groq\n    LoginRecovery --&gt; [*] : Trigger Google re-login\\nRestore session cookies\n    LinkRecovery --&gt; [*] : Send Telegram [Class Missed]\\nSkip this class\n}\n\nExceptionHandling --&gt; IdleScheduler : Action [Log stored for debugging]\\nResume scheduler\n\nActiveClassMonitoring --&gt; LeavingClass : Guard [Participants &lt; 5]\\nOR [Class time finished + 5 min buffer]\n\nstate LeavingClass {\n    [*] --&gt; ClosingBrowser : Bot clicks Leave button\\n(Browser automation via Playwright)\n    ClosingBrowser --&gt; LeaveError : [Browser / network error on leave]\n    LeaveError --&gt; ClosingBrowser : Retry leave button\n    ClosingBrowser --&gt; SendingSummaryLogs : Successfully left class\n    SendingSummaryLogs --&gt; CheckingNextClass : Send Telegram [Class Left]\\n+ Duration log (e.g. 1hr 20min)\\n+ Attendance Marked / Missed status\\n+ Timestamp\n    CheckingNextClass --&gt; [*] : Query schedule.json\\nfor next class entry\n}\n\nLeavingClass --&gt; IdleScheduler : [Next class exists]\\nAllow 20-min late joining window\nLeavingClass --&gt; [*] : [No more classes scheduled today]\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="U94ImedzpO5kRR1ZKo_--0">
          <mxCell parent="AdNmpqE42daUev6yq7hu-1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="7990.44" width="2920" x="200" y="-1240" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
